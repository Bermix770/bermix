		Ores = {
			{ Name = "Sapphire",   HP = 600,  Value = 600,  Weight = 55, Size = 6, Color = Color3.fromRGB(30, 80, 255),   Material = Enum.Material.Glass, Style = "Crystal", Glow = true },
